<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmiCompanion.Gui.MainWindow"
        Title="AmiCompanion"
        Width="960" Height="680"
        MinWidth="720" MinHeight="500">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24">
    <StackPanel Spacing="6">
      <TextBlock Text="AmiCompanion" FontSize="30" FontWeight="Bold" />
      <TextBlock Text="Cross-platform Amiga companion toolkit — M1 Inspect" FontSize="16" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,24,0,0" ColumnDefinitions="*,Auto">
      <TextBox x:Name="FilePathBox" Watermark="Select an ADF, HDF/RDB, Kickstart ROM or Amiga Hunk file…" />
      <Button Grid.Column="1" Margin="10,0,0,0" Padding="18,8" Content="Open…" Click="OpenFile_Click" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,18,0,0" ColumnDefinitions="220,*">
      <StackPanel Spacing="8">
        <TextBlock Text="Inspect as" FontSize="18" FontWeight="SemiBold" />
        <Button Content="Checksums" HorizontalAlignment="Stretch" Click="Checksum_Click" />
        <Button Content="ADF image" HorizontalAlignment="Stretch" Click="Adf_Click" />
        <Button Content="Kickstart ROM" HorizontalAlignment="Stretch" Click="Rom_Click" />
        <Button Content="Amiga Hunk" HorizontalAlignment="Stretch" Click="Hunk_Click" />
      </StackPanel>

      <Border Grid.Column="1" Margin="24,0,0,0" Padding="18" BorderThickness="1" CornerRadius="6">
        <ScrollViewer>
          <TextBlock x:Name="ResultText" Text="Choose a file, then select an inspector." FontFamily="Monospace"
                     TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
