<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmiCompanion.Gui.MainWindow"
        Title="AmiCompanion"
        Width="900" Height="600"
        MinWidth="640" MinHeight="420">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <StackPanel Spacing="6">
      <TextBlock Text="AmiCompanion" FontSize="30" FontWeight="Bold" />
      <TextBlock Text="Cross-platform Amiga companion toolkit — M0" FontSize="16" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,28,0,0" ColumnDefinitions="*,*">
      <StackPanel Spacing="10">
        <TextBlock Text="Inspect" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="ADF/HDF, ROM and Hunk tools arrive in M1." TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="10">
        <TextBlock Text="Hardware" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Gotek, Greaseweazle, CF/SD and transfer support follow in later milestones." TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
